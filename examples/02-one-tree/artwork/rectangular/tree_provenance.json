      ],
      "referenceUses": []
    },
    "selected-taxon-projection@1.0.0": {
      "id": "selected-taxon-projection",
      "version": "1.0.0",
      "category": "scientific",
      "status": "implemented",
      "specification": "selected_taxon_projection_v1: orient the exact immutable input at its declared root; retain selected-tip paths and root/stem, explicitly collapse requested nodes, suppress only unannotated unlabeled unary intermediate nodes, retain ordered original paths/edge IDs and selected/original/omitted memberships. No selected-tip distance threshold and no inferred support type.",
      "specificationSha256": "600c6ab74ccccb292fa4bab4de2530457fabe0d4ed0a89d0a4b74a13e297297d",
