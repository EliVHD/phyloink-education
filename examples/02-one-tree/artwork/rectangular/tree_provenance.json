  "methods": {
    "bounded-overview@1.0.0": {
      "id": "bounded-overview",
      "version": "1.0.0",
      "category": "scientific",
      "status": "implemented",
      "specification": "bounded_overview_v1: begin with the traversal root children; repeatedly split the frontier internal node with greatest original-tip membership (ties by source ID) whose children fit within 100 endpoints. Stop when no further split fits. Save remaining internal frontier nodes as explicit collapses, with distance threshold zero. Preserve every original tip exactly once; no invented edges or omitted taxa.",
      "specificationSha256": "f4b3199a27ba75d0c6d765e3d6102d427633b1a6d803adabe747ae69cdee2e9a",
      "parameterSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "defaults": {},
      "limitations": [
        "An initial display overview, not a biological grouping criterion or evidence assessment. Internal numeric labels are not assigned support meanings. Large root polytomies that exceed the bound are rejected rather than sampled silently."
      ],
      "referenceUses": []
    },
    "clade-cluster@1.0.0": {
      "id": "clade-cluster",
      "version": "1.0.0",
      "category": "layout",
      "status": "implemented",
      "specification": "clade_cluster_v1: allocate measured ordered terminal slots and nested clade intervals; junction transverse coordinate is the interval midpoint; height is one plus maximum child height and nonmetric depth is 1-height/rootHeight. Map to rectangular or unwrapped circular/fan coordinates. Use open compound connectors and radial/horizontal stems. At most eight measured-label slot passes, fixed font size, bounded clade/level offsets and explicit pin conflicts.",
      "specificationSha256": "2e945d7bc8a4495557ca5b890795292567a9c95c0b1404864d797d6a8671b776",
      "parameterSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "defaults": {},
      "limitations": [
        "Original application construction inspired by general cluster and subtree-sector concepts; not a reproduction of D3 or the Bachmaier algorithm. Depth, arc length and inner radius are spacing conventions, not time/distance/confidence."
      ],
      "referenceUses": [
        {
          "referenceId": "d3-cluster-docs",
          "role": "algorithm",
          "relationship": "inspired-by"
        },
        {
          "referenceId": "bachmaier-2005",
          "role": "algorithm",
          "relationship": "inspired-by"
        }
      ]
    },
    "compound-validation@3.0.0": {
      "id": "compound-validation",
      "version": "3.0.0",
      "category": "validation",
      "status": "implemented",
      "specification": "compound_scene_validation_v3: retain compound v2 geometry checks and its 500000-operation ceiling. Attachment tests return attached, detached or incomplete. Track incidence completeness independently before stroke/label checks; incidencePassed requires completed attachment checks with no detected failure. Truncation never asserts incidence success or fabricates a detached attachment. Preserve compound v1/v2 implementations for exact saved replay.",
      "specificationSha256": "e9bef3918a34388b3f748472f2cbbf18a1ea77ea73e00b2bd25e5843cf3ab7aa",
      "parameterSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "defaults": {},
      "limitations": [
        "Numerical validation with explicit bounds and work-limit disclosure; no mathematical nonintersection proof, biological peer review or classroom validation."
      ],
      "referenceUses": []
    },
    "maximal-frontier@1.0.0": {
      "id": "maximal-frontier",
      "version": "1.0.0",
      "category": "scientific",
      "status": "implemented",
      "specification": "maximal_frontier_v1: original-tip-weighted mean descendant distance, strict less-than threshold, protected override paths and explicit collapse/expand/protect rules. Preserve exhaustive original tip memberships.",
      "specificationSha256": "5476846d2315714317c4e4b718f11ac8f2d1f382149d7c63aedfdca5b85f7567",
      "parameterSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "defaults": {},
      "limitations": [
        "Root is explicitly assumed; missing lengths prevent distance-threshold collapsing."
      ],
      "referenceUses": []
    },
    "newick-parser@1.0.0": {
      "id": "newick-parser",
      "version": "1.0.0",
      "category": "import",
      "status": "implemented",
      "specification": "Parse one Newick tree, preserving source text, local IDs, raw labels, comments and length tokens. No support type is inferred from numeric labels.",
      "specificationSha256": "df2868ed492b0c5af089ee20b8b55d64f977143bbade3f54ea8df502cd3562d6",
      "parameterSchema": {
        "type": "object",
        "additionalProperties": true
      },
